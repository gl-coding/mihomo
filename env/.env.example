# Mihomo 订阅与多订阅设置（复制为 .env.mihomo.local，勿提交 Git）
# 路径：devtools/mihomo/env/.env.mihomo.local

# 旧版单订阅（兼容）
# MIHOMO_SUBSCRIPTION_URL=
# MIHOMO_SUBSCRIPTION_PROXY=false
# MIHOMO_SUBSCRIPTION_UPDATED_AT=

# 多订阅（管理页 / CLI 保存后自动生成）
# MIHOMO_SUBSCRIPTIONS_JSON=
# MIHOMO_SUBSCRIPTION_ACTIVE_ID=

# 可选：覆盖 API / 代理（通常用 nginxmgr/settings 或 shell 环境变量即可）
# MIHOMO_API_BASE=http://127.0.0.1:9090
# MIHOMO_HTTP_PROXY=http://127.0.0.1:7890
