# bin — 可执行文件与官方压缩包
bin/mihomo
bin/*.gz

# conf — 运行配置、订阅缓存、Geo 数据
conf/active.yaml
conf/iKuuu*.yaml
conf/config.yaml
conf/*.bak
conf/profiles/*
!conf/profiles/.gitkeep
conf/geo/*
!conf/geo/.gitkeep

# cache — 运行缓存与日志
cache/*
!cache/.gitkeep

# 旧版平铺布局（迁移后可能残留）
mihomo
*.gz
*.mmdb
*.metadb
GeoSite.dat
GeoIP.dat
iKuuu*.yaml
config.yaml
*.log
cache.db
.subscription*
*.bak
/profiles/

__pycache__/
*.py[cod]

# 独立管理页
admin/.venv/
admin/node_modules/
admin/.cache/
admin/standalone/dist/

# 订阅与环境（独立仓使用 repo 根 env/）
env/*
!env/.gitkeep
